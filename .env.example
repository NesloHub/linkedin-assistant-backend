# Copy this file to ".env" and fill in your real values.
# The .env file is ignored by git (see your global .gitignore) — never commit it.

# Your secret Google Gemini key. This stays on the server and never reaches the browser.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the model (defaults to gemini-flash-latest).
# gemini-flash-latest always points at Google's newest flash model.
GEMINI_MODEL=gemini-flash-latest

# Port the server listens on locally.
PORT=8787
